name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: python scripts/validate_skill.py
      - name: Verify referenced paths exist
        run: |
          python -c "
          import re
          text = open('SKILL.md').read()
          base = ''
          for ref in re.findall(r'\`([^\`]+)\`', text):
            if '/' in ref or ref.endswith('.md') or ref.endswith('.py'):
              import os
              if not os.path.exists(ref):
                print(f'Missing referenced path: {ref}')
                exit(1)
          print('All referenced paths exist')
          "